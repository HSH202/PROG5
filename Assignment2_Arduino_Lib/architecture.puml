@startuml class-diagram
title PortableBmp280 - class diagram
skinparam classAttributeIconSize 0
skinparam shadowing false
left to right direction

package "Sketch / application" as app {
  class "BasicReadout.ino" as Sketch <<sketch>> {
    setup()
    loop()
  }
}

package "Portable core  (no MCU headers, only <stdint.h>)" as core #E8F5E9 {
  interface I2cTransport {
    +readRegisters(reg: uint8_t, buf: uint8_t*, len: size_t): bool
    +writeRegisters(reg: uint8_t, buf: const uint8_t*, len: size_t): bool
    +delayMs(ms: uint16_t): void
  }

  class Bmp280Driver {
    +{static} kAddressLow = 0x76
    +{static} kAddressHigh = 0x77
    +Bmp280Driver(transport: I2cTransport&)
    +begin(): bool
    +softReset(): bool
    +chipId(): uint8_t
    +read(out: Measurement&): bool
    -readChipId(id: uint8_t&): bool
    -loadCalibration(): bool
    -startNormalMode(): bool
    -compensateTemperature(adcT: int32_t): int32_t
    -compensatePressure(adcP: int32_t): uint32_t
    -cal_: Calibration
    -tFine_: int32_t
  }

  class Measurement <<struct>> {
    +temperatureCenti: int32_t
    +pressurePa: uint32_t
    +temperatureC(): float
    +pressureHpa(): float
  }

  class Calibration <<struct>> {
    T1: uint16_t
    T2, T3: int16_t
    P1: uint16_t
    P2 .. P9: int16_t
  }
}

package "Platform adapters  (one per MCU / OS)" as plat #FFF3E0 {
  class WireTransport <<Arduino>> {
    -wire_: TwoWire&
    -address_: uint8_t
  }
  class LinuxI2cTransport <<Raspberry Pi - later>> {
    -fd_: int
    -address_: uint8_t
  }
  class MockTransport <<host unit test>> {
    -regs_: uint8_t[256]
  }
}

Sketch ..> Bmp280Driver : calls begin() / read()
Sketch ..> WireTransport : creates
Bmp280Driver o--> I2cTransport : io_ (depends on abstraction)
Bmp280Driver *-- Calibration
Bmp280Driver ..> Measurement : fills

WireTransport      ..|> I2cTransport
LinuxI2cTransport  ..|> I2cTransport
MockTransport      ..|> I2cTransport

note bottom of plat
  Porting = add one class here.
  Nothing in the green package changes.
end note
@enduml


@startuml sequence-diagram
title PortableBmp280 - startup and one reading
skinparam shadowing false
autonumber

participant "Sketch" as S
participant "Bmp280Driver" as D
participant "WireTransport" as T
participant "BMP280 chip" as C

== setup() ==
S -> D : begin()
D -> T : writeRegisters(0xE0, 0xB6)
T -> C : I2C write (soft reset)
D -> T : delayMs(5)
D -> T : readRegisters(0xD0, 1)
T -> C : I2C read
C --> D : chip ID (0x58 / 0x60)
D -> D : check ID is known
D -> T : readRegisters(0x88, 24)
C --> D : calibration bytes
D -> D : parse into Calibration (signed / unsigned)
D -> T : writeRegisters(0xF4, 0x27)
T -> C : normal mode, temp x1, press x1
D -> T : delayMs(10)
D --> S : true

== loop() ==
S -> D : read(measurement)
D -> T : readRegisters(0xF7, 6)
T -> C : burst read press[3] + temp[3]
C --> D : 6 raw bytes
D -> D : build 20-bit adcP / adcT\nreject 0x80000 (not ready)
D -> D : compensateTemperature(adcT)\n(sets tFine_)
D -> D : compensatePressure(adcP)\n(uses tFine_)
D --> S : true, Measurement{centi-degC, Pa}
S -> S : Serial.print(...)
@enduml
